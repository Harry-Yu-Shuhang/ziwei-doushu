# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# /api/interpret（命盘页 AI 解读）会读取下面这组配置；只想排盘、看命盘的话不用填。
# 合盘 AI 分析 /api/heming 不在开源范围内，需要你自己实现。
AI_PROVIDER=deepseek
# DeepSeek 当前最强模型（V4 Pro，1M 上下文）；更便宜/更快可换 deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
